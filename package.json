{
  "name": "the-city",
  "description": "A deterministic 30-day trading game set across New York City's five boroughs.",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc -b && vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "prettier": "latest",
    "vitest": "latest",
    "typescript": "latest",
    "vite": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
